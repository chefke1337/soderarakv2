# Mérési azonosítók — a statikus exportba égődnek be (NEXT_PUBLIC_*).
# Kitöltés után: npm run build
# Üresen hagyva a site mérés nélkül fut (nincs GA4, nincs banner, nincs GSC meta).

# GA4 mérési azonosító (Web data stream → Measurement ID)
NEXT_PUBLIC_GA4_ID=

# "1" esetén GA4 DebugView jelzés (fejlesztéshez)
NEXT_PUBLIC_GA4_DEBUG=

# Search Console HTML-tag verifikáció — csak a content érték, pl. google5e1f...
NEXT_PUBLIC_GSC_VERIFICATION=

# Rendelési igény beküldésének végpontja (V3).
# A statikus export nem tud szerveroldali route-ot kiszolgálni, ezért a
# backend KÜLÖN fut — lásd server/README.md.
# Lokális mock backendhez:  npm run mock:order
#   NEXT_PUBLIC_ORDER_API_URL=http://127.0.0.1:8788/order
# Üresen hagyva a kliens NEM szimulál sikeres küldést: konfigurációs hibát jelez.
NEXT_PUBLIC_ORDER_API_URL=

# "false" esetén az oldal indexelhető. Minden más (vagy üres) érték = noindex előnézet.
NEXT_PUBLIC_PREVIEW=
